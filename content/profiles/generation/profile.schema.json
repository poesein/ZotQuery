{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZotQuery Reading Generation Protocol",
  "type": "object",
  "required": ["id", "version", "name", "readingProfileId", "kind", "sourcePolicy", "evidencePolicy", "branches"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "readingProfileId": { "type": "string", "minLength": 1 },
    "kind": { "const": "reading-generation-protocol" },
    "sourcePolicy": { "type": "object", "required": ["originalResearchRequiresCompletePdfText", "requireContiguousReadToNull"] },
    "evidencePolicy": { "type": "object", "required": ["separateRoles", "noInventedQuantities", "absenceMustBeExplicit"] },
    "branches": {
      "type": "object",
      "required": ["original_research", "review", "design_note"],
      "additionalProperties": {
        "type": "object",
        "required": ["requiredSections", "softVisibleCharacters"],
        "properties": {
          "requiredSections": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
          "softVisibleCharacters": { "type": "integer", "minimum": 1 },
          "minEvidenceUnits": { "type": "integer", "minimum": 1 },
          "minCoreFigures": { "type": "integer", "minimum": 1 },
          "figureFields": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "additionalProperties": false
}
